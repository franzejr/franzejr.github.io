---
import Header from '../components/Header.astro';
import type { Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  lang: Lang;
  path: string;
  title: string;
  description: string;
  langLinks?: Partial<Record<Lang, string>>;
}

const { lang, path, title, description, langLinks } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <Header lang={lang} path={path} langLinks={langLinks} />
    <main>
      <slot />
    </main>
  </body>
</html>
