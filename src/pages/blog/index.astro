---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPostsByLang } from '../../lib/posts';

const posts = await getPostsByLang('en');
---

<BaseLayout lang="en" path="/blog" title="Blog — Franze M" description="Blog posts by Franze M.">
  <h1>Blog</h1>
  {posts.length === 0 && <p class="muted">No posts yet — check back soon.</p>}
  {posts.map((post) => <PostCard post={post} lang="en" />)}
</BaseLayout>
