---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPostsByLang } from '../../../lib/posts';

const posts = await getPostsByLang('fr');
---

<BaseLayout lang="fr" path="/blog" title="Blog — Franze M" description="Articles de blog par Franze M.">
  <h1>Blog</h1>
  {posts.length === 0 && <p class="muted">Pas encore d'articles — revenez bientôt.</p>}
  {posts.map((post) => <PostCard post={post} lang="fr" />)}
</BaseLayout>
