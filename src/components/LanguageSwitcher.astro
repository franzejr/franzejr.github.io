---
import { languages, languageCodes } from '../i18n/ui';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  // path without locale prefix, e.g. "/blog/" or "/"
  path: string;
  // optional precomputed links (e.g. for blog posts where the slug may
  // differ per language, or a translation may not exist yet)
  links?: Partial<Record<Lang, string>>;
}

const { lang, path, links } = Astro.props;

function hrefFor(target: Lang) {
  if (links?.[target]) return links[target] as string;
  const clean = path === '/' ? '' : path;
  return target === 'en' ? `${clean}/` || '/' : `/${target}${clean}/`;
}
---

<nav class="lang-switcher" aria-label="Language switcher">
  {Object.entries(languages).map(([code, label]) => (
    <a
      href={hrefFor(code as Lang)}
      title={label}
      hreflang={code}
      aria-current={code === lang ? 'true' : undefined}
    >
      {languageCodes[code as Lang]}
    </a>
  ))}
</nav>

<style>
  .lang-switcher {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
  }
  .lang-switcher a {
    padding: 0.3rem 0.625rem;
    border-radius: 999px;
    color: var(--muted);
  }
  .lang-switcher a:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .lang-switcher a[aria-current='true'] {
    color: var(--paper);
    background: var(--ink);
  }
</style>
