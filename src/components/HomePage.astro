---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import { getPostsByLang, formatDate } from '../lib/posts';
import { useTranslations, localizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const t = useTranslations(lang);
const posts = (await getPostsByLang(lang)).slice(0, 3);
---

<BaseLayout lang={lang} path="/" title={title} description={description}>
  <section class="hero">
    <p class="eyebrow accent">{t('home.eyebrow')}</p>
    <h1 class="page-title"><slot name="heading" /></h1>
    <div class="intro"><slot /></div>
    <div class="actions">
      <a class="btn" href={localizedPath(lang, '/blog')}>{t('home.readBlog')} <span aria-hidden="true">→</span></a>
      <a class="quiet" href="https://github.com/franzejr">github.com/franzejr</a>
      <a class="quiet" href="mailto:franzejr@gmail.com">franzejr@gmail.com</a>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="latest">
      <div class="latest-head">
        <h2 class="eyebrow">{t('home.latest')}</h2>
        <a class="mono all" href={localizedPath(lang, '/blog')}>{t('home.allPosts')} →</a>
      </div>
      {posts.map((post) => (
        <div class="row entry">
          <time class="mono muted" datetime={post.data.publishDate.toISOString().slice(0, 10)}>
            {formatDate(post.data.publishDate, lang)}
          </time>
          <PostCard post={post} lang={lang} showDate={false} />
        </div>
      ))}
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: 45rem;
    margin-top: 1.5rem;
  }
  .accent {
    color: var(--accent);
  }
  .page-title {
    font-size: clamp(2.75rem, 7vw, 4.25rem);
  }
  .intro {
    font-size: 1.375rem;
    line-height: 1.5;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    padding-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .quiet {
    color: var(--muted);
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }
  .quiet:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .latest {
    margin-top: 6rem;
    display: flex;
    flex-direction: column;
  }
  .latest-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.875rem;
    border-bottom: 1px solid var(--rule);
  }
  .latest-head h2 {
    color: var(--muted);
  }
  .all {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
  .entry {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .entry time {
    font-size: 0.8125rem;
    padding-top: 0.5rem;
  }
  @media (max-width: 640px) {
    .hero {
      margin-top: 0;
      gap: 1.25rem;
    }
    .intro {
      font-size: 1.1875rem;
    }
    .latest {
      margin-top: 4rem;
    }
    .entry time {
      padding-top: 0;
    }
  }
</style>
