---
import { marked } from 'marked';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  slugOf,
  formatDate,
  readingTime,
  getPostLangLinks,
  getAdjacentPosts,
  postHref,
  type Post,
} from '../lib/posts';
import { useTranslations, localizedPath } from '../i18n/utils';
import { languages, type Lang } from '../i18n/ui';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const lang = post.data.lang as Lang;
const t = useTranslations(lang);
const langLinks = await getPostLangLinks(post);
const { newer, older } = await getAdjacentPosts(post);
const html = marked.parse(post.data.body);
const isoDate = post.data.publishDate.toISOString().slice(0, 10);

// Languages this post is also available in.
const translations = (Object.keys(langLinks) as Lang[])
  .filter((code) => code !== lang)
  .map((code) => ({ code, label: languages[code], href: langLinks[code] as string }));
---

<BaseLayout
  lang={lang}
  path={`/blog/${slugOf(post)}`}
  title={`${post.data.title} — Franze M`}
  description={post.data.description}
  langLinks={langLinks}
>
  <article class="post">
    <header class="post-head">
      <a class="back mono" href={localizedPath(lang, '/blog')}>
        <span aria-hidden="true">←</span> {t('blog.backToBlog')}
      </a>
      {post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      )}
      <h1 class="page-title">{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
      <div class="meta">
        <time datetime={isoDate}>{formatDate(post.data.publishDate, lang)}</time>
        <span class="sep" aria-hidden="true">·</span>
        <span>{readingTime(post)} {t('blog.minRead')}</span>
        {translations.length > 0 && (
          <span class="also">
            <span class="sep" aria-hidden="true">·</span>
            <span>
              {t('blog.alsoIn')}{' '}
              {translations.map((item, i) => (
                <>
                  {i > 0 && ` ${t('blog.and')} `}
                  <a href={item.href} hreflang={item.code}>{item.label}</a>
                </>
              ))}
            </span>
          </span>
        )}
      </div>
    </header>

    <div class="prose" set:html={html} />

    <footer class="post-foot">
      <div class="byline mono">
        <span>{t('blog.writtenBy')} Franze M</span>
        <a href="https://github.com/franzejr">github.com/franzejr</a>
      </div>
      {(newer || older) && (
        <nav class="adjacent" aria-label="Post navigation">
          {older ? (
            <a class="title-link card" href={postHref(older)}>
              <span class="eyebrow muted">← {t('blog.older')}</span>
              <span class="card-title">{older.data.title}</span>
            </a>
          ) : (
            <div />
          )}
          {newer ? (
            <a class="title-link card newer" href={postHref(newer)}>
              <span class="eyebrow muted">{t('blog.newer')} →</span>
              <span class="card-title">{newer.data.title}</span>
            </a>
          ) : (
            <div />
          )}
        </nav>
      )}
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: var(--prose-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .post-head {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    min-height: 2.75rem;
  }
  .back:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .description {
    font-size: 1.375rem;
    line-height: 1.45;
    font-style: italic;
    color: var(--muted);
  }
  .post-head .meta {
    padding-top: 1.125rem;
    border-top: 1px solid var(--rule);
  }
  .also {
    display: inline-flex;
    gap: 0.875rem;
  }
  .post-foot {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .byline a {
    color: var(--muted);
  }
  .byline a:hover {
    color: var(--ink);
  }
  .adjacent {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
  }
  .card:hover {
    border-color: var(--accent);
  }
  .card.newer {
    text-align: right;
  }
  .card-title {
    font-size: 1.1875rem;
    line-height: 1.3;
  }
  @media (max-width: 640px) {
    .adjacent {
      grid-template-columns: 1fr;
    }
    .card.newer {
      text-align: left;
    }
    .description {
      font-size: 1.1875rem;
    }
  }
</style>
