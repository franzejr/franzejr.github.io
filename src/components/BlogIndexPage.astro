---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import { getPostsByLang, groupByYear } from '../lib/posts';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const t = useTranslations(lang);
const groups = groupByYear(await getPostsByLang(lang));
---

<BaseLayout lang={lang} path="/blog" title={title} description={description}>
  <section class="head">
    <h1 class="page-title">{t('blog.title')}</h1>
    <p class="lede">{t('blog.intro')}</p>
  </section>

  {groups.length === 0 && <p class="muted empty">{t('blog.empty')}</p>}

  <section class="years">
    {groups.map((group) => (
      <div class="row year">
        <p class="eyebrow muted">{group.year}</p>
        <div class="posts">
          {group.posts.map((post) => <PostCard post={post} lang={lang} />)}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 45rem;
    margin-bottom: 3.5rem;
  }
  .empty {
    margin-bottom: 3rem;
  }
  .years {
    border-bottom: 1px solid var(--rule);
  }
  .year {
    padding: 1.5rem 0 0.5rem;
    border-top: 1px solid var(--rule);
  }
  .year .eyebrow {
    padding-top: 0.625rem;
  }
  .posts {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    padding: 0.5rem 0 1.75rem;
  }
  @media (max-width: 640px) {
    .head {
      margin-bottom: 2.5rem;
    }
    .year .eyebrow {
      padding-top: 0;
    }
  }
</style>
