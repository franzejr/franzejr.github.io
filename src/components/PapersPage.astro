---
import BaseLayout from '../layouts/BaseLayout.astro';
import { papers, scholarUrl, authorName } from '../data/papers';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} path="/papers" title={title} description={description}>
  <section class="head">
    <h1 class="page-title">{t('papers.title')}</h1>
    <p class="lede">{t('papers.intro')}</p>
    <a class="btn" href={scholarUrl}>{t('papers.scholar')} <span aria-hidden="true">→</span></a>
  </section>

  <section class="list">
    {papers.map((paper) => (
      <article class="row paper">
        <p class="eyebrow muted">{paper.year ?? '—'}</p>
        <div class="body">
          <h2><a class="title-link" href={paper.href}>{paper.title}</a></h2>
          <p class="authors">
            {paper.authors.map((author, i) => (
              <>
                {i > 0 && ', '}
                {author === authorName ? <strong>{author}</strong> : author}
              </>
            ))}
          </p>
          {paper.venue && <p class="venue muted">{paper.venue}</p>}
          <p class="summary">{paper.summary}</p>
          <a class="mono link" href={paper.href}>{paper.linkLabel} →</a>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    max-width: 45rem;
    margin-bottom: 3.5rem;
  }
  .head .btn {
    margin-top: 0.5rem;
  }
  .list {
    border-bottom: 1px solid var(--rule);
  }
  .paper {
    padding: 1.75rem 0 2rem;
    border-top: 1px solid var(--rule);
  }
  .paper .eyebrow {
    padding-top: 0.5rem;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  h2 {
    font-size: 1.625rem;
    line-height: 1.2;
  }
  .authors {
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  .authors strong {
    font-weight: 600;
  }
  .venue {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .summary {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--muted);
    margin-top: 0.25rem;
  }
  .link {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }
  @media (max-width: 640px) {
    .head {
      margin-bottom: 2.5rem;
    }
    .paper .eyebrow {
      padding-top: 0;
    }
    h2 {
      font-size: 1.375rem;
    }
  }
</style>
