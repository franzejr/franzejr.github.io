---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations, localizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
  langLinks?: Partial<Record<Lang, string>>;
}

const { lang, path, langLinks } = Astro.props;
const t = useTranslations(lang);

const items: { href: string; label: string; active: boolean }[] = [
  { href: localizedPath(lang, '/'), label: t('nav.home'), active: path === '/' },
  { href: localizedPath(lang, '/blog'), label: t('nav.blog'), active: path.startsWith('/blog') },
  { href: localizedPath(lang, '/papers'), label: t('nav.papers'), active: path.startsWith('/papers') },
  { href: localizedPath(lang, '/contact'), label: t('nav.contact'), active: path.startsWith('/contact') },
];
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href={localizedPath(lang, '/')}>Franze M</a>
    <nav class="nav" aria-label="Main navigation">
      {items.map((item) => (
        <a href={item.href} aria-current={item.active ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
    <LanguageSwitcher lang={lang} path={path} links={langLinks} />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.25rem var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }
  .brand {
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-right: auto;
  }
  .brand:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .nav {
    display: flex;
    gap: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .nav a {
    color: var(--muted);
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }
  .nav a:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .nav a[aria-current='page'] {
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .bar {
      gap: 0.25rem 1rem;
    }
    .nav {
      order: 3;
      flex-basis: 100%;
      gap: 1.25rem;
    }
  }
</style>
