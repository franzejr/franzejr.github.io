---
import { slugOf, type Post } from '../lib/posts';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  post: Post;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === 'en' ? '' : `/${lang}`;
const href = `${prefix}/blog/${slugOf(post)}/`;
const formattedDate = post.data.publishDate.toLocaleDateString(lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="post-card">
  <h2><a href={href}>{post.data.title}</a></h2>
  <p class="muted date">{formattedDate}</p>
  <p>{post.data.description}</p>
  <a class="read-more" href={href}>{t('blog.readMore')} →</a>
</article>

<style>
  .post-card {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .post-card:first-of-type {
    padding-top: 0;
  }
  .date {
    font-size: 0.875rem;
    margin-top: -0.5rem;
  }
</style>
